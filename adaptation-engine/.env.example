# Copy to .env.local and fill in. Never commit the real file.

# Anthropic API key. Used server-side only.
ANTHROPIC_API_KEY=

# Local SQLite database.
DATABASE_URL="file:./dev.db"

# Model used by the extract / analyse / plan / rewrite stages. Recorded on
# every StageRun row, so changing it here changes the audit trail for future
# runs only — completed runs keep the model they actually ran on.
ADAPTATION_MODEL=claude-sonnet-5

# Model used by the fidelity and back-translation stages. Set this to the
# strongest model you have access to: these two stages are the safety net, and
# they are the only place in the pipeline where being slower and dearer is
# unambiguously worth it. It is deliberately a separate variable so the
# governance record shows that verification did not run on a cheaper model
# than the rewrite.
FIDELITY_MODEL=claude-sonnet-5
