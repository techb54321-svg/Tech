# Copy to .env and fill in what you need. Never commit .env.
# Everything is optional: with nothing set, Hazel runs with the
# demonstration, in-app reminders, Uber hand-off and "ask family".

# --- Server -------------------------------------------------------------
PORT=8787
# Use 0.0.0.0 to reach the server from a phone on your network.
HOST=127.0.0.1
# SQLite database file (created automatically).
DATABASE_FILE=./data/alongside.db
# Set to true when served over HTTPS so cookies are marked Secure
# (automatic when NODE_ENV=production).
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy (for correct client IPs).
TRUST_PROXY=false
# Set to off to disable the public demonstration on a production server.
DEMO_MODE=on
# Public https URL of this server, used for SMS delivery-status callbacks.
PUBLIC_BASE_URL=

# --- Text messages (Twilio) -----------------------------------------------
# When all three are set, help and lift requests can also be texted to the
# family contact (if "Text the family contact" is ticked in Family setup).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Transport -------------------------------------------------------------
# Optional Uber client id added to the hand-off link (not a secret).
UBER_CLIENT_ID=
# Ride booking inside the app needs an authorised provider integration.
# "test" enables a local TEST provider for development only (no real rides).
TRANSPORT_PROVIDER=
