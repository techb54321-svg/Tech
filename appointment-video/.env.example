# Copy this file to ".env" and fill in your real key.
# The key stays on your computer — the browser never sees it.
#
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: change the port the app runs on (default 3000)
# PORT=3000

# Optional: demo mode — set to 1 to use a canned example answer
# so you can try the app without an API key.
# MOCK=1
