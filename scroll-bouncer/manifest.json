{
  "manifest_version": 3,
  "name": "Scroll Bouncer",
  "version": "1.1.0",
  "description": "A little guy walks out and closes the tab whenever you open social media.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["defaults.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Scroll Bouncer",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "browser_specific_settings": {
    "gecko": { "id": "scroll-bouncer@example.invalid", "strict_min_version": "121.0" },
    "gecko_android": { "strict_min_version": "121.0" }
  }
}
